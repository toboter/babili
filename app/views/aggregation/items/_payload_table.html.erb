<%# locals: commit (preferred) or values: Hash, columns: Array optional %>
<% pairs =
     if local_assigns[:commit]
       commit.ordered_payload_pairs
     else
       source = (values || {}).each_with_object({}) { |(k, v), memo| memo[k.to_s] = v }
       order = Array(local_assigns[:columns]).map(&:to_s).presence || source.keys
       order.filter_map { |key| source.key?(key) ? [key, source[key]] : nil } +
         source.reject { |k, _| order.include?(k) }.to_a
     end %>

<% if pairs.any? %>
  <div class="table-responsive">
    <table class="table table-striped table-condensed table-bordered" style="margin-bottom: 0;">
      <thead>
        <tr>
          <th style="width: 30%;">Column</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        <% pairs.each do |key, value| %>
          <tr>
            <th class="text-nowrap text-muted" style="font-weight: 600;"><%= key %></th>
            <td><%= value.nil? || value == "" ? content_tag(:span, "—", class: "text-muted") : value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-muted" style="margin-bottom: 0;">Empty payload.</p>
<% end %>
