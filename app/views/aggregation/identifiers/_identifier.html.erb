<tr id="data-identifier-<%= identifier.id %>">
  <td>
    <%= link_to identifier.origin_id,
          aggregation_identifier_path(identifier),
          class: "text-strong" %>
  </td>
  <td>
    <%= content_tag :span, identifier.origin_type, class: "text-muted" %>
  </td>
  <td class="text-small">
    <%= identifier.origin_agent_id.presence || content_tag(:span, "—", class: "text-muted") %>
  </td>
  <td class="text-right text-small">
    <%= content_tag :span, identifier.items.size, class: "badge" %>
  </td>
</tr>
