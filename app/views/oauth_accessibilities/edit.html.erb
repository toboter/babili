<% accessor = @oauth_accessibility.accessor %>

<div class="page-header" style="margin-top:0px;">
  <h3 style="margin-top:0px;">
    Edit access for <%= accessor.try(:name) || 'unknown' %>
  </h3>
  <p class="text-muted">
    <%= oauth_accessor_kind(accessor) if accessor %>
    on
    <strong><%= @oauth_application.name %></strong>.
    Change the abilities below, then sync to the client if needed.
  </p>
</div>

<%= simple_form_for([@oauth_application, @oauth_accessibility], url: oauth_application_accessibility_path(@oauth_application, @oauth_accessibility), method: :put) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <h5 class="text-strong">Permissions</h5>
    <%= render 'permissions_fields', f: f %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, 'Save permissions', class: 'btn btn-primary text-strong' %>
    <%= link_to 'Cancel', oauth_application_accessibilities_path(@oauth_application), class: 'btn btn-default text-strong' %>
  </div>
<% end %>
