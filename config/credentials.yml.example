# Populate encrypted credentials with:
#   bin/rails credentials:edit
# Production decrypts with RAILS_MASTER_KEY (never commit config/master.key).

secret_key_base: # bin/rails secret
host: api.dev.local:3000
FROM: noreply@localhost
TO: admin@localhost
GMAIL_USERNAME:
GMAIL_PASSWORD:
recaptcha_site_key:
recaptcha_secret_key:
# Searchkick / OpenSearch (HTTPS + basic auth for Docker security plugin)
opensearch_url: https://admin:YOUR_PASSWORD@localhost:9200
