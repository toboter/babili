# Copy to config/database.yml and adjust.
# Use host: localhost so Postgres uses password auth (not peer on Unix socket).

default: &default
  adapter: postgresql
  encoding: unicode
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
  host: localhost
  port: 5432
  username: rails
  password: rails

development:
  <<: *default
  database: babili_development

test:
  <<: *default
  database: babili_test

production:
  <<: *default
  database: babili_production
  # url: <%= ENV['DATABASE_URL'] %>
